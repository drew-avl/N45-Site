# Hosted form/email endpoint used by the static GitHub Pages build.
# The endpoint should send mail from noreply@n45tech.com and set Reply-To to
# the submitted email address.
VITE_CONTACT_ENDPOINT=

# Public Microsoft Bookings URL. Use BOOKING_URL for one shared scheduling page,
# or set the service-specific URLs to send each appointment to its own calendar.
VITE_BOOKING_URL=
VITE_SECURITY_TRIAGE_BOOKING_URL=
VITE_IT_REVIEW_BOOKING_URL=
